{
  "manifest_version": 3,
  "name": "Use Google AI Mode?",
  "version": "1.1.2",
  "minimum_chrome_version": "103",
  "description": "Open Google AI Mode when your search contains a customizable prefix, suffix, or phrase.",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
