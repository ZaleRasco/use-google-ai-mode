{
  "manifest_version": 3,
  "name": "Use Google AI Mode?",
  "version": "1.1.2",
  "description": "Open Google AI Mode when your search contains a customizable prefix, suffix, or phrase.",
  "browser_specific_settings": {
    "gecko": {
      "id": "google-question-ai-mode@local.example",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://google.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
